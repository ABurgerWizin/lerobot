{
  "env": {
    "task": "manipulation_task",
    "fps": 10,
    "robot": {
      "type": "so101_follower",
      "port": "/dev/ttyACM1",
      "id": "my_awesome_follower_arm",
      "cameras": {
        "front": {
          "type": "opencv",
          "index_or_path": 0,
          "width": 1280,
          "height": 720,
          "fps": 30
        }
      }
    },
    "teleop": {
      "type": "gamepad",
      "use_gripper": true
    },
    "processor": {
      "control_mode": "gamepad",
      "observation": {
        "add_joint_velocity_to_observation": true,
        "add_current_to_observation": true,
        "display_cameras": false
      },
      "image_preprocessing": {
        "crop_params_dict": {
          "observation.images.front": [270, 170, 90, 190]
        },
        "resize_size": [128, 128]
      },
      "gripper": {
        "use_gripper": true,
        "gripper_penalty": -0.02
      },
      "reset": {
        "fixed_reset_joint_positions": [0.0, 0.0, 0.0, 90.0, 0.0, 5.0],
        "reset_time_s": 5,
        "control_time_s": 30.0,
        "terminate_on_success": true
      },
      "inverse_kinematics": {
        "urdf_path": "/home/wedonttalkabout/repository/lerobot-hirl/SO-ARM100/Simulation/SO101/so101_new_calib.urdf",
        "target_frame_name": "gripper_frame_link",
        "end_effector_bounds": {
          "min": [0.014, -0.3105, -0.0289],
          "max": [0.4451, 0.3109, 0.1614]
        },
        "end_effector_step_sizes": {
          "x": 0.02,
          "y": 0.02,
          "z": 0.02
        }
      },
      "reward_classifier": {
        "pretrained_path": null,
        "success_threshold": 0.5,
        "success_reward": 1.0
      },
      "max_gripper_pos": 100.0
    }
  },
  "dataset": {
    "repo_id": "armada/so101_manipulation",
    "task": "Pick orange cube and put it in the box",
    "root": "/home/wedonttalkabout/.cache/huggingface/lerobot/armada/so101_manipulation",
    "num_episodes_to_record": 2,
    "replay_episode": null,
    "push_to_hub": false
  },
  "mode": "record",
  "device": "cpu"
}
